# Local-only demo values. Copy to .env — never commit .env.

# Postgres superuser (supabase/postgres image)
POSTGRES_PASSWORD=wandersync_local_pw

# Ingestion (Prefect schedule + scrape plan, docs/design.md §6)
INGEST_CRON=0 */6 * * *
INGEST_ROUTES=BOG-CTG,CTG-BOG,BOG-MDE,MDE-BOG,BOG-SMR,SMR-BOG
INGEST_DAYS_AHEAD=7,14
INGEST_STAY_NIGHTS=3

# One login role per service (db/01_schema.sql)
FLIGHTS_DB_PASSWORD=flights_local_pw
HOTELS_DB_PASSWORD=hotels_local_pw
CARS_DB_PASSWORD=cars_local_pw
ORDERS_DB_PASSWORD=orders_local_pw
GATEWAY_DB_PASSWORD=gateway_local_pw
INGESTION_DB_PASSWORD=ingestion_local_pw
